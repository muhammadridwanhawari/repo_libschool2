            <a href="<?php echo e(route('register')); ?>" class="font-bold text-[#4475F2] hover:text-blue-700 hover:underline">
                Klik disini untuk register
            </a>
        </div>
    </div>

    <script>
        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.innerHTML = isHidden
                ? `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>`;
        }

        function formatDuration(totalSeconds) {
            if (totalSeconds >= 3600) {
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);

                return minutes > 0 ? `${hours} jam ${minutes} menit` : `${hours} jam`;
            }

            if (totalSeconds >= 60) {
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;

                return seconds > 0 ? `${minutes} menit ${seconds} detik` : `${minutes} menit`;
            }

            return `${totalSeconds} detik`;
        }

        function setLoginDisabled(disabled) {
            const fields = [
                document.getElementById('username'),
                document.getElementById('password'),
                document.getElementById('login-submit'),
            ];

            fields.forEach((field) => {
                if (field) {
                    field.disabled = disabled;
                }
            });

            const submitButton = document.getElementById('login-submit');

            if (submitButton) {
                submitButton.textContent = disabled ? 'Tunggu sebentar...' : 'Login';
                submitButton.classList.toggle('opacity-70', disabled);
                submitButton.classList.toggle('cursor-not-allowed', disabled);
            }
        }

        const loginAlertModal = document.getElementById('login-alert-modal');
        const loginAlertClose = document.getElementById('login-alert-close');
        const loginAlertCountdown = document.getElementById('login-alert-countdown');
        const loginAlertMessage = document.getElementById('login-alert-message');

        if (loginAlertClose && loginAlertModal) {
            loginAlertClose.addEventListener('click', () => {
                loginAlertModal.classList.add('hidden');
            });
        }

        if (loginAlertCountdown) {
            let secondsRemaining = Number(loginAlertCountdown.dataset.seconds || 0);
            let timerId = null;

            if (secondsRemaining > 0) {
                setLoginDisabled(true);

                const updateCountdown = () => {
                    loginAlertCountdown.textContent = formatDuration(secondsRemaining);

                    if (secondsRemaining <= 0) {
                        if (timerId) {
                            clearInterval(timerId);
                        }

                        setLoginDisabled(false);

                        if (loginAlertMessage) {
                            loginAlertMessage.textContent = 'Masa tunggu selesai. Silakan coba login lagi.';
                        }

                        return;
                    }

                    secondsRemaining -= 1;
                };

                updateCountdown();
                timerId = window.setInterval(updateCountdown, 1000);
            }
        }
    </script>
</body>
</html>
